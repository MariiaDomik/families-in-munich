{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Next.js server",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "console": "integratedTerminal",
            "env": {
                "NODE_OPTIONS": "--inspect"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Debug Next.js client (Chrome)",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}"
        }
    ]
}